# cPanel production environment variables.
# Set these in cPanel -> Environment Variables (or .env on the server).
# NEVER commit real values to Git. Provide via GitHub Secrets for CI and cPanel env vars at runtime.

CPANEL_FTP_HOST=
CPANEL_FTP_USER=
CPANEL_FTP_PASS=
CPANEL_SSH_HOST=
CPANEL_SSH_USER=
CPANEL_SSH_KEY=
CPANEL_PUBLIC_HTML=/public_html

DATABASE_URL=
CPANEL_DATABASE_URL=
SECRET_KEY=
MODEL_VERSION=v1
GLOBAL_VERIFY_ENABLED=true
LOCAL_VERIFY_ENABLED=true
KINSHIP_VERIFICATION_ENABLED=true
ML_INFERENCE_BACKEND=onnx
