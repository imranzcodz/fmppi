# FMPPI Environment Variables (copy to .env and fill in secrets)
# Never commit .env — it contains secrets

# Backend
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_SCHEME=bcrypt
BCRYPT_ROUNDS=12

# Database (MySQL on cPanel / local SQLite for dev)
DATABASE_URL=sqlite:///./fmppi.db
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/fmppi

# ML / Model
MODEL_VERSION=v1
GLOBAL_VERIFY_ENABLED=true
LOCAL_VERIFY_ENABLED=true
ML_SERVICE_URL=http://localhost:8001

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_GLOBAL_VERIFY_ENABLED=true

# MFA
MFA_ISSUER=FMPPI
MFA_WINDOW=1

# Upload limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20

# CORS
CORS_ORIGINS=*

# Debug
DEBUG=False
