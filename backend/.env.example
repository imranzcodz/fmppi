# FMPPI Backend environment variables (copy to .env and fill in secrets; never commit .env)
DATABASE_URL=mysql+pymysql://fmppi_user:fmppi_pass@localhost:3306/fmppi

SECRET_KEY=change-me-in-production-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_SCHEME=bcrypt
BCRYPT_ROUNDS=12

MFA_ISSUER=FMPPI
MFA_WINDOW=1

MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20

CORS_ORIGINS=*
DEBUG=false
